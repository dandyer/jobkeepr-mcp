{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.jobkeepr/jobkeepr",
  "title": "Jobkeepr",
  "description": "Manage jobs, customers, scheduling, estimates and invoices for a field service business.",
  "version": "1.0.0",
  "websiteUrl": "https://jobkeepr.com",
  "repository": {
    "url": "https://github.com/dandyer/jobkeepr-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://jobkeepr.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "jobkeepr-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JOBKEEPR_API_KEY",
          "description": "API key from Jobkeepr Settings > API Keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
